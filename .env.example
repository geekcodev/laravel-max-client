# Access token бота (обязательная). Передаётся в заголовке Authorization без префикса Bearer.
MAX_API_TOKEN=

# Секрет для верификации вебхуков. 5-256 символов [a-zA-Z0-9_-].
# Пока не задан — роут /max/webhook не регистрируется (fail-closed).
MAX_WEBHOOK_SECRET=

# Включить регистрацию вебхук-роута (true/false).
MAX_WEBHOOK_ENABLED=

# Очередь, в которую ставятся джобы обработки Update.
MAX_WEBHOOK_QUEUE=

# Путь вебхук-роута. По умолчанию /max/webhook.
MAX_WEBHOOK_PATH=

# Базовый URI API MAX. По умолчанию https://platform-api2.max.ru (домен platform-api2).
MAX_BASE_URI=

# Ретраи (экспоненциальный бэкофф).
MAX_RETRY_MAX_ATTEMPTS=
MAX_RETRY_BASE_DELAY=
MAX_RETRY_MAX_DELAY=
MAX_RETRY_FACTOR=
MAX_RETRY_ON_NON_IDEMPOTENT=

# Rate limit (token bucket 2 req/s на диалог/чат/канал).
MAX_RATE_LIMIT_TOKENS_PER_SECOND=
MAX_RATE_LIMIT_MAX_TOKENS=

# Long Polling — только для локальной разработки (вебхук требует публичного домена).
# Запуск: php artisan max:listen. Активная webhook-подписка отключает Long Polling.
MAX_POLLING_LIMIT=
MAX_POLLING_TIMEOUT=
MAX_POLLING_BREAK_ON_FAILURE=

# Срок жизни auth_date в стартовых данных мини-приложения, сек (replay-защита; 0 — не проверять).
MAX_WEBAPP_MAX_AGE=
