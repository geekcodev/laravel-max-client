{
    "name": "geekcodev/laravel-max-client",
    "description": "Laravel adapter for the MAX Messenger Bot API client (geekcodev/max-php-client)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/geekcodev/laravel-max-client",
    "keywords": [
        "laravel",
        "max",
        "messenger",
        "bot",
        "api",
        "client",
        "psr-18",
        "webhook",
        "queue"
    ],
    "authors": [
        {
            "name": "Evgeny Semenov",
            "email": "geekco@yandex.ru",
            "homepage": "https://github.com/geekcodev"
        }
    ],
    "require": {
        "php": "^8.4",
        "geekcodev/max-php-client": "^1.0.3",
        "guzzlehttp/guzzle": "^7.15",
        "laravel/framework": "^12.0|^13.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "GeekCo\\LaravelMaxClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GeekCo\\LaravelMaxClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GeekCo\\LaravelMaxClient\\MaxServiceProvider"
            ],
            "aliases": {
                "Max": "GeekCo\\LaravelMaxClient\\Facades\\Max"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "coverage": "phpunit --coverage-clover build/coverage.xml && php scripts/check-coverage.php",
        "audit": "composer audit"
    },
    "config": {
        "sort-packages": true
    }
}
